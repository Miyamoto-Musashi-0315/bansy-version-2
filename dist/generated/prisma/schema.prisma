// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum UserRole {
  HR
  CANDIDATE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(HR)
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tests     Test[]
}

model Resume {
  id         String   @id @default(uuid())
  email      String
  filename   String
  path       String
  size       Int
  analysis   Json? // Stores the AI analysis results
  tests      Test[] // Tests generated for this resume
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Test {
  id           String       @id @default(uuid())
  title        String
  description  String?
  difficulty   String // easy, medium, hard
  language     String
  requirements Json // Array of project requirements
  testCases    Json // Array of test cases with inputs and expected outputs
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  creator      User         @relation(fields: [creatorId], references: [id])
  creatorId    String
  resume       Resume?      @relation(fields: [resumeId], references: [id])
  resumeId     String?
  projectFiles Json // Stores the project files and structure
  submissions  Submission[]
}

model Submission {
  id        String   @id @default(uuid())
  test      Test     @relation(fields: [testId], references: [id])
  testId    String
  code      Json // Stores the submitted code files
  results   Json? // Stores test results and AI evaluation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
